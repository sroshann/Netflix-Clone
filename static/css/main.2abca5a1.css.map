#SMovie-root {

    display: grid;
    row-gap: 25px;

}

#SMovie-root p {

    width: fit-content;
    height: fit-content;
    margin: 0;
    color: white;
    cursor: default;
    width: fit-content;

}

#banner-view {

    height: 654px;
    background-size: cover;

}

#fade {

    height: 6rem;
    position: relative;
    bottom: 96px;
    background: linear-gradient(360deg, rgba(0, 0, 0, 1), rgba(0, 0, 0, 0));

}

#details-view {

    width: 60%;
    height: 654px;
    display: grid;
    place-items: center;
    background: linear-gradient(90deg, rgba(0, 0, 0, 1), rgba(0, 0, 0, 0));
    color: white;

}

#item {

    width: 75%;
    height: fit-content;

}

#title {

    font-size: 2.5rem;
    font-weight: 800;
    width: fit-content;
    max-width: 430px;
    line-height: 1.2;

}

#rating-year {

    display: flex;
    column-gap: 8px;
    font-size: 13px;
    width: fit-content;
    margin: 6px 0px 0px 0px;

}

#genre {

    display: flex;
    column-gap: 5px;
    font-size: 13px;
    margin-top: 8px;

}

#genre p {

    padding: 5px 13px;
    background-color: rgba(51, 51, 51, 0.5);
    border-radius: 3.5px;

}

#description-div {

    margin-top: 10px;
    height: fit-content;
    padding: 15px 20px 15px 20px;
    background-color: rgba(51, 51, 51, 0.5);
    width: 76.5%;
    margin: auto;
    border-radius: 8px;

}

#description-div::-webkit-scrollbar {
    display: none;
}

#description-div p:nth-child(2) {
    font-size: 13.5px;
}



#youtube {

    display: grid;
    width: 87%;
    margin: auto auto 50px auto;

}

#youtube .scroll-msg-div p {

    position: relative;
    bottom: -12px;
    left: 6px;

}

#yt-videos,
#responsive-yt-videos {
    margin-right: 10px;
}

#play-yt-videos {

    display: flex;
    padding: 5px 8px 0px 8px;
    overflow-x: scroll;
    overflow-y: hidden;
    scroll-behavior: smooth;
}

#play-yt-videos::-webkit-scrollbar {
    display: none;
}

#one-yt-videos {

    padding: 8px;
    width: 87%;
    margin: auto auto auto auto;

}

#one-yt-videos #yt-videos {
    padding: 0;
}

#two-yt-videos {

    padding: 8px;
    display: flex;
    scroll-behavior: smooth;

}

#two-yt-videos::-webkit-scrollbar {
    display: none;
}

#casts {

    margin: 10px auto auto auto;
    display: grid;
    width: 77%;

}

.scroll-msg-div {

    display: flex;
    justify-content: end;

}

.scroll-msg-div p {

    font-size: 9.5px;
    padding: 0px 2.5px 2.8px 0px;

}

.scroll-msg-div i {

    position: relative;
    top: 2.5px;
    left: -1.5px;
    font-size: 13px;

}

#casts-scroll {

    display: flex;
    column-gap: 8px;
    overflow-x: scroll;
    overflow-y: hidden;
    scroll-behavior: smooth;

}

#casts-scroll::-webkit-scrollbar {
    display: none;
}

#cast-details {

    height: 265px;
    width: min-content;
    background-color: rgba(51, 51, 51, 0.5);
    border-radius: 6px;

}

#casts img {

    width: 120px;
    height: 180px;
    object-fit: cover;
    border-radius: 6px 6px 4px 4px;

}

#charecter-name {
    padding: 3px 0px 0px 8px;
}

#charecter-name p {

    font-size: 12px;
    max-width: 105px;

}

#charecter-name p:nth-child(1),
#charecter-name p:nth-child(2) {
    line-height: 1.2;
}

#charecter-name p:nth-child(2) {

    color: gray;
    padding-top: 3px;

}


/* RESPONSIVE */
@media (max-width : 767px) {

    #banner-view,
    #details-view {
        height: 280px;
    }

    #details-view { width: 65%; }

    #title {
        font-size: 1rem;
    }

    #genre { width: max-content; }

    #genre p {

        border-radius: 3.5px;
        padding: 5px 5px;
        font-size: 0.8rem;

    }

    #rating-year p,
    #rating-year span {
        font-size: 0.8rem;
    }

    #description-div p:nth-child(1) {
        font-size: 15px;
    }

    #description-div p:nth-child(2) {
        font-size: 0.8rem;
    }

    #description-div {

        margin-top: 10px;
        padding: 11px 16px 11px 16px;
        width: 74%;
        border-radius: 7px;
        margin-top: -3px;

    }

    #casts {

        width: 74%;
        margin-top: -4px;

    }

    #cast-details {
        height: 208px;
    }

    #casts img {

        width: 100px;
        height: 140px;
        border-radius: 5px 5px 3px 3px;

    }

    #charecter-name p {
        font-size: 0.5rem;
    }

    #youtube {

        width: 75%;
        margin-top: -4px;

    }

    #youtube .scroll-msg-div p {

        position: relative;
        bottom: -4px;
        left: -9.5px;

    }

    #play-yt-videos,
    #two-yt-videos {

        padding: 5px 8px 0px 8px;
        width: 92%;

    }

    #two-yt-videos {

        overflow-x: scroll;
        overflow-y: hidden;
        scroll-behavior: smooth;

    }

    .scroll-msg-div p {

        font-size: 0.68rem;
        padding: 0px 0px 2.8px 0px;

    }

    .scroll-msg-div i {
        font-size: 0.8rem;
    }

}